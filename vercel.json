{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "analytics/app.py",
      "use": "@vercel/python"
    },
    {
      "src": "backend/app/main.py",
      "use": "@vercel/python"
    }
  ],
  "rewrites": [
    {
      "source": "/analytics-api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/prediction-api/(.*)",
      "destination": "/api/predict/$1"
    },
    {
      "source": "/api/predict/(.*)",
      "destination": "/backend/app/main.py"
    },
    {
      "source": "/api/(.*)",
      "destination": "/analytics/app.py"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/$1"
    }
  ]
}